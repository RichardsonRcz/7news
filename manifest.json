{
  "manifest_version": 3,
  "name": "公开新闻阅读台",
  "version": "1.1.2",
  "description": "手动刷新公开新闻，按时间、来源和主题筛选，中英文报道共同阅读。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://news.google.com/*"
  ],
  "action": {
    "default_title": "打开公开新闻阅读台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://news.google.com; style-src 'self'; img-src 'self' data:;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
